# Bili2Text Plus 环境变量示例
# 复制为 .env（不要提交 .env），或直接使用 Windows 用户环境变量。
# 所有 Key 只保存在本机，绝不要提交到 Git。

# ============ AI 润色配置（通用 OpenAI 兼容接口） ============
# 服务商可选 zhipu / minimax / custom，也可以不填让程序根据 Base URL 自动判断
# LLM_PROVIDER=zhipu

# API Key（必填才能使用 AI 润色；不配置时原始转写功能不受影响）
# LLM_API_KEY=your_api_key_here

# OpenAI 兼容接口地址
# 智谱:   https://open.bigmodel.cn/api/paas/v4
# MiniMax: https://api.minimax.cn/v1
# LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# 模型 ID
# 智谱免费模型: glm-4.7-flash    MiniMax: MiniMax-M3
# LLM_MODEL=glm-4.7-flash

# ============ 旧版兼容（可选） ============
# 以下变量与上面的 LLM_* 等效，LLM_* 优先级更高。
# MINIMAX_APIKEY=your_api_key_here
# MINIMAX_API_BASE=https://api.minimax.cn/v1
# MINIMAX_MODEL=MiniMax-M3

# ============ 云端 Whisper（可选，默认关闭） ============
# OPENAI_API_KEY=
# USE_OPENAI_WHISPER=0
# OPENAI_WHISPER_MODEL=whisper-1

# ============ 本地文件导入方式（可选，默认复制） ============
# 默认 copy：把文件复制一份到 bilibili_video/local_*/ 缓存，原文件绝不被修改。
# 只有显式设为 hardlink 才使用硬链接（同盘零拷贝）。硬链接与原文件共享数据，
# 若手动修改缓存里的该文件，原文件也会一起变化，请谨慎使用。
# BILI2TEXT_LOCAL_IMPORT=copy

# ============ 抖音下载（可选，默认关闭） ============
# yt-dlp 的抖音提取器当前要求浏览器会话（即使视频是公开的）。
# 这里只是把你本机浏览器已有的会话交给 yt-dlp，仅用于你本来就能正常观看的
# 公开视频，不涉及绕过登录、付费或隐私限制。不配置时保持默认行为。
#
# 注意：2026 年起抖音对非浏览器访问收紧了风控，即使配置了有效 cookies，
# 详情接口仍可能返回 403（新版 Chrome/Edge 的 App-Bound 加密也会导致
# --cookies-from-browser 读取失败，此时请用浏览器扩展导出 cookies.txt）。
# 若仍然失败，请在浏览器里正常下载视频，再用界面上的「选择文件…」直接转写。
# YTDLP_COOKIES_FROM_BROWSER=edge
# YTDLP_COOKIE_FILE=C:\path\to\cookies.txt

# ============ 字幕获取（V2，可选） ============
# B站字幕接口需要登录态才能返回 CC 字幕；匿名访问对多数视频返回空列表。
# 这里可以复用上面 YTDLP_COOKIE_FILE 导出的 cookies（只用于你本就能观看的公开视频）。
#
# YouTube 在本机需要代理才能获取元数据与字幕；该变量只影响字幕/元数据请求，
# 不影响 B站 的直连下载逻辑。
# YTDLP_PROXY=http://127.0.0.1:7897
